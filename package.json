{
  "name": "hindi-tts",
  "version": "1.0.0",
  "private": true,
  "description": "Hindi Text-to-Speech web app using Microsoft Edge TTS",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon backend/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node backend/index.js",
    "postinstall": "echo Installed."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "msedge-tts": "^1.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
